<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Use the validated variant receiver; the dependency receiver is removed. -->
        <activity
            android:name="io.github.chenxiex.calibrecloud.auth.OneDriveCallbackActivity"
            android:enabled="${appAuthRedirectEnabled}"
            android:exported="true"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${appAuthRedirectScheme}"
                    android:host="${appAuthRedirectHost}"
                    android:path="${appAuthRedirectPath}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
