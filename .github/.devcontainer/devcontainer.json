{
    "name": "Calibre Cloud Android",
    "build": {
        "dockerfile": "Dockerfile",
        "options": ["--platform=linux/amd64"]
    },
    "runArgs": ["--platform=linux/amd64"],
    "init": true,
    "mounts": [
        "source=calibre-cloud-${devcontainerId}-gradle,target=/home/vscode/.gradle,type=volume",
        "source=calibre-cloud-${devcontainerId}-sdk,target=/home/vscode/.local/share/android-sdk,type=volume",
        "source=calibre-cloud-${devcontainerId}-android,target=/home/vscode/.android,type=volume",
        "source=calibre-cloud-${devcontainerId}-cache,target=/home/vscode/.cache,type=volume"
    ],
    "postCreateCommand": ["bash", "/usr/local/share/calibre-devcontainer/post-create.sh"],
    "waitFor": "postCreateCommand",
    "customizations": {
        "vscode": {
            "extensions": [
                "mathiasfrohlich.Kotlin",
                "redhat.java",
                "vscjava.vscode-gradle"
            ],
            "settings": {
                "java.import.gradle.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
                "java.configuration.runtimes": [
                    {
                        "name": "JavaSE-21",
                        "path": "/usr/lib/jvm/java-21-openjdk-amd64",
                        "default": true
                    }
                ]
            }
        }
    }
}
